<local:LensWindow x:Class="CleanMagnifier.Windows.ViewerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:CleanMagnifier.Windows"
                  xmlns:chrome="clr-namespace:CleanMagnifier.Controls"
                  Title="깔끔한 돋보기" Width="720" Height="420">
    <!-- 바깥 여백은 그림자와 잡기 영역. -->
    <Grid x:Name="Surface" Background="Transparent">
        <Border Margin="{x:Static chrome:ChromeLayout.ViewerHitArea}" Background="#01000000"
                CornerRadius="{x:Static chrome:ChromeLayout.ViewerHitCorner}" />

        <Border Margin="{x:Static chrome:ChromeLayout.ViewerContent}" CornerRadius="{x:Static chrome:ChromeLayout.ViewerCorner}"
                Background="{DynamicResource ViewerBackBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.32" />
            </Border.Effect>
        </Border>

        <Border x:Name="Lens" Margin="{x:Static chrome:ChromeLayout.ViewerContent}"
                CornerRadius="{x:Static chrome:ChromeLayout.ViewerCorner}" />

        <Grid x:Name="Crosshair" Margin="{x:Static chrome:ChromeLayout.ViewerContent}"
              IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.75">
            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
        </Grid>

        <Border Margin="{x:Static chrome:ChromeLayout.ViewerContent}" CornerRadius="{x:Static chrome:ChromeLayout.ViewerCorner}"
                BorderThickness="1" BorderBrush="{DynamicResource ViewerOutlineBrush}" IsHitTestVisible="False" />

        <Border x:Name="Badge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Padding="12,5" CornerRadius="12" Background="#D01C1C1E" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12" FontFamily="{StaticResource UiFont}" />
        </Border>
    </Grid>
</local:LensWindow>
