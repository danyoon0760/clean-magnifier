<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 색은 Colors.Light/Dark.xaml 에 있고 Theme.Apply 가 하나를 고른다. 강조색은 설정에서 바뀐다. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>

    <DropShadowEffect x:Key="MenuShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22" />

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12,8,12,16" Padding="5" CornerRadius="9"
                            Background="{DynamicResource MenuBackBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
                            Effect="{StaticResource MenuShadow}">
                        <StackPanel IsItemsHost="True" MinWidth="220" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,5" Background="{DynamicResource MenuSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Height="32" Margin="0,1" Padding="10,0,10,0"
                            CornerRadius="5" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Check" Data="M0,4.5 L3.6,8 L10.5,0.5" Width="11" Height="9"
                                  Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Hidden" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MenuSubTextBrush}" />

                            <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Width="5" Height="9"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stroke="{DynamicResource MenuSubTextBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Hidden" />

                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-14"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="12,8,12,16" Padding="5" CornerRadius="9"
                                        Background="{DynamicResource MenuBackBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
                                        Effect="{StaticResource MenuShadow}">
                                    <StackPanel IsItemsHost="True" MinWidth="150"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
